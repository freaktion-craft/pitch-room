{
  "name": "pitchroom",
  "productName": "Pitchroom",
  "version": "1.0.0",
  "private": true,
  "description": "Sing along to any song: its stems, your pitch on the melody, takes to listen back to.",
  "author": "freaktion",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "python": "node scripts/fetch-python.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.freaktion.pitchroom",
    "productName": "Pitchroom",
    "artifactName": "Pitchroom-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "..",
        "to": "app-code",
        "filter": [
          "server.py",
          "stems.py",
          "melody.py",
          "syllables.py",
          "lyrics.py",
          "covers.py",
          "playlists.py",
          "index.html",
          "favicon.svg",
          "requirements-stems.txt",
          "LICENSE",
          "css/**",
          "js/**"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pitchroom listens to you sing, to show your pitch against the melody and to record takes."
      }
    },
    "dmg": {
      "title": "Pitchroom"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pitchroom"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "freaktion-craft",
        "repo": "pitchroom-releases",
        "releaseType": "draft"
      }
    ]
  }
}
