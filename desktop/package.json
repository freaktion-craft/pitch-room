{
  "name": "pitchroom",
  "productName": "Pitchroom",
  "version": "1.0.35",
  "private": true,
  "description": "Sing along to any song: its stems, your pitch on the melody, takes to listen back to.",
  "author": "freaktion",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "python": "node scripts/fetch-python.mjs",
    "code": "node scripts/prepare-code.mjs",
    "start": "electron .",
    "dist": "node scripts/prepare-code.mjs && electron-builder --publish never",
    "release": "node scripts/prepare-code.mjs && electron-builder --publish always",
    "release-mac": "node scripts/release-mac.mjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "lightningcss": "1.33.0",
    "terser": "5.51.2"
  },
  "build": {
    "appId": "com.freaktion.pitchroom",
    "productName": "Pitchroom",
    "artifactName": "Pitchroom-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/check-packed.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "mac-update.js",
      "splash.html",
      "update-splash.ps1",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "build-code",
        "to": "app-code"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pitchroom listens to you sing, to show your pitch against the melody and to record takes."
      }
    },
    "dmg": {
      "title": "Pitchroom"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-win.png",
      "extraResources": [
        {
          "from": "vbcable",
          "to": "vbcable"
        }
      ]
    },
    "nsis": {
      "artifactName": "pitchroom_install.${ext}",
      "installerIcon": "build/installerIcon.ico",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pitchroom"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "freaktion-craft",
        "repo": "pitchroom-releases",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
